{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".test-dist/**",
        "coverage/**"
      ],
      "env": [
        "TZ"
      ]
    }
  },
  "globalDependencies": [
    "tsconfig.base.json",
    ".nvmrc"
  ]
}
